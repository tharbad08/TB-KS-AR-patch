<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TBKSARPatch</AssemblyName>
    <RootNamespace>TBKSARPatch</RootNamespace>
    <Version>1.1.2</Version>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/*.cs" />
  </ItemGroup>
  <Import Project="refs/ReferenceAssemblies.props" Condition="Exists('refs/ReferenceAssemblies.props')" />
  <Target Name="RequireRealReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('refs/Timberborn.BlockSystem.dll') Or !Exists('refs/AcademicsRainborn.dll') Or !Exists('refs/Code.dll') Or !Exists('refs/0Harmony.dll') Or !Exists('refs/ReferenceAssemblies.props')" Text="Run python3 scripts/prepare_refs.py /path/to/your/reference.zip first. Genuine game/mod DLLs required." />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TBKSARPatch</AssemblyName>
    <RootNamespace>TBKSARPatch</RootNamespace>
    <Version>1.1.2</Version>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/*.cs" />
    <ReferenceDll Include="refs/*.dll" />
    <Reference Include="%(ReferenceDll.Filename)">
      <HintPath>%(ReferenceDll.FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireRealReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('refs/Timberborn.BlockSystem.dll') Or !Exists('refs/AcademicsRainborn.dll') Or !Exists('refs/Code.dll') Or !Exists('refs/0Harmony.dll')" Text="Run python3 scripts/prepare_refs.py /path/to/your/reference.zip first. Genuine game/mod DLLs required." />
  </Target>
</Project>
